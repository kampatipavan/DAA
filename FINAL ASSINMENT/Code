import math
import random
import time

# ----------------------------------------------------------
# GLOBAL COUNTERS
# ----------------------------------------------------------
brute_comparisons = 0
divide_comparisons = 0
hybrid_comparisons = 0


# ----------------------------------------------------------
# EUCLIDEAN DISTANCE
# ----------------------------------------------------------
def distance(p1, p2):
    return math.sqrt(
        (p1[0] - p2[0]) ** 2 +
        (p1[1] - p2[1]) ** 2
    )


# ==========================================================
# 1. BRUTE FORCE ALGORITHM
# ==========================================================
def brute_force(points):
    global brute_comparisons

    min_distance = float("inf")
    closest_pair = None

    n = len(points)

    for i in range(n):
        for j in range(i + 1, n):

            brute_comparisons += 1

            d = distance(points[i], points[j])

            if d < min_distance:
                min_distance = d
                closest_pair = (points[i], points[j])

    return closest_pair, min_distance


# ==========================================================
# 2. DIVIDE AND CONQUER ALGORITHM
# ==========================================================
def strip_closest(strip, d, best_pair):
    global divide_comparisons

    strip.sort(key=lambda point: point[1])

    min_distance = d
    closest_pair = best_pair

    for i in range(len(strip)):

        j = i + 1

        while (
            j < len(strip)
            and (strip[j][1] - strip[i][1]) < min_distance
        ):

            divide_comparisons += 1

            dist = distance(strip[i], strip[j])

            if dist < min_distance:
                min_distance = dist
                closest_pair = (strip[i], strip[j])

            j += 1

    return closest_pair, min_distance


def divide_and_conquer_recursive(points):

    global divide_comparisons

    n = len(points)

    # Base case
    if n <= 3:

        min_distance = float("inf")
        closest_pair = None

        for i in range(n):
            for j in range(i + 1, n):

                divide_comparisons += 1

                d = distance(points[i], points[j])

                if d < min_distance:
                    min_distance = d
                    closest_pair = (points[i], points[j])

        return closest_pair, min_distance

    # Find middle point
    mid = n // 2
    mid_point = points[mid]

    left_points = points[:mid]
    right_points = points[mid:]

    # Recursive calls
    left_pair, left_distance = divide_and_conquer_recursive(
        left_points
    )

    right_pair, right_distance = divide_and_conquer_recursive(
        right_points
    )

    # Select minimum
    if left_distance < right_distance:

        min_distance = left_distance
        closest_pair = left_pair

    else:

        min_distance = right_distance
        closest_pair = right_pair

    # Create strip
    strip = []

    for point in points:

        if abs(point[0] - mid_point[0]) < min_distance:
            strip.append(point)

    # Find closer pair in strip
    strip_pair, strip_distance = strip_closest(
        strip,
        min_distance,
        closest_pair
    )

    if strip_distance < min_distance:

        min_distance = strip_distance
        closest_pair = strip_pair

    return closest_pair, min_distance


def divide_and_conquer(points):

    sorted_points = sorted(
        points,
        key=lambda point: point[0]
    )

    return divide_and_conquer_recursive(sorted_points)


# ==========================================================
# 3. HYBRID ALGORITHM
# ==========================================================
def hybrid_brute_force(points):

    global hybrid_comparisons

    min_distance = float("inf")
    closest_pair = None

    for i in range(len(points)):

        for j in range(i + 1, len(points)):

            hybrid_comparisons += 1

            d = distance(points[i], points[j])

            if d < min_distance:
                min_distance = d
                closest_pair = (points[i], points[j])

    return closest_pair, min_distance


def hybrid_recursive(points, threshold):

    global hybrid_comparisons

    n = len(points)

    # Switching condition
    if n <= threshold:
        return hybrid_brute_force(points)

    mid = n // 2
    mid_point = points[mid]

    left_points = points[:mid]
    right_points = points[mid:]

    left_pair, left_distance = hybrid_recursive(
        left_points,
        threshold
    )

    right_pair, right_distance = hybrid_recursive(
        right_points,
        threshold
    )

    # Choose smaller distance
    if left_distance < right_distance:

        min_distance = left_distance
        closest_pair = left_pair

    else:

        min_distance = right_distance
        closest_pair = right_pair

    # Create strip
    strip = []

    for point in points:

        if abs(point[0] - mid_point[0]) < min_distance:
            strip.append(point)

    strip.sort(key=lambda point: point[1])

    # Check strip
    for i in range(len(strip)):

        j = i + 1

        while (
            j < len(strip)
            and strip[j][1] - strip[i][1] < min_distance
        ):

            hybrid_comparisons += 1

            d = distance(strip[i], strip[j])

            if d < min_distance:
                min_distance = d
                closest_pair = (strip[i], strip[j])

            j += 1

    return closest_pair, min_distance


def hybrid_algorithm(points, threshold=10):

    sorted_points = sorted(
        points,
        key=lambda point: point[0]
    )

    return hybrid_recursive(
        sorted_points,
        threshold
    )


# ==========================================================
# DATASET GENERATION
# ==========================================================
def generate_dataset(n):

    points = []

    for i in range(n):

        latitude = random.uniform(-90, 90)
        longitude = random.uniform(-180, 180)

        points.append(
            (latitude, longitude)
        )

    return points


# ==========================================================
# TEST ONE DATASET
# ==========================================================
points = generate_dataset(1000)

print("Number of Points:", len(points))


# ----------------------------------------------------------
# BRUTE FORCE
# ----------------------------------------------------------
brute_comparisons = 0

start = time.perf_counter()

pair_bf, distance_bf = brute_force(points)

end = time.perf_counter()

brute_time = end - start


# ----------------------------------------------------------
# DIVIDE AND CONQUER
# ----------------------------------------------------------
divide_comparisons = 0

start = time.perf_counter()

pair_dc, distance_dc = divide_and_conquer(points)

end = time.perf_counter()

divide_time = end - start


# ----------------------------------------------------------
# HYBRID
# ----------------------------------------------------------
hybrid_comparisons = 0

threshold = 10

start = time.perf_counter()

pair_hybrid, distance_hybrid = hybrid_algorithm(
    points,
    threshold
)

end = time.perf_counter()

hybrid_time = end - start


# ==========================================================
# DISPLAY RESULTS
# ==========================================================

print("\n========== BRUTE FORCE ==========")

print("Closest Pair :", pair_bf)
print("Minimum Distance :", distance_bf)
print("Execution Time :", brute_time, "seconds")
print("Distance Comparisons :", brute_comparisons)


print("\n========== DIVIDE AND CONQUER ==========")

print("Closest Pair :", pair_dc)
print("Minimum Distance :", distance_dc)
print("Execution Time :", divide_time, "seconds")
print("Distance Comparisons :", divide_comparisons)


print("\n========== HYBRID ALGORITHM ==========")

print("Threshold :", threshold)
print("Closest Pair :", pair_hybrid)
print("Minimum Distance :", distance_hybrid)
print("Execution Time :", hybrid_time, "seconds")
print("Distance Comparisons :", hybrid_comparisons)


# ==========================================================
# CORRECTNESS CHECK
# ==========================================================

if (
    abs(distance_bf - distance_dc) < 1e-9
    and abs(distance_bf - distance_hybrid) < 1e-9
):

    print("\nAll three algorithms produced the same result.")

else:

    print("\nWarning: Results are different.")
